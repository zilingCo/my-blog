---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'zilingCo ',
  description = '��¼ѧϰ一个自由记录工作学习和兴趣的人',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href="/" class="brand">zilingCo</a>
        <div class="links">
          <a href="/">��ҳ</a>
          <a href="/blog">����</a>
          <a href="/about">����</a>
        </div>
      </nav>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>? {new Date().getFullYear()} zilingCo</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --fg: #1a1a1a;
    --muted: #666;
    --bg: #fff;
    --border: #e5e5e5;
    --accent: #2563eb;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI',
      'PingFang SC', 'Microsoft YaHei', sans-serif;
    line-height: 1.7;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .site-header nav {
    max-width: 720px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--fg);
    text-decoration: none;
  }

  .links a {
    margin-left: 1.25rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .links a:hover { color: var(--accent); }

  .site-main {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    padding: 1.5rem;
  }

  a { color: var(--accent); }
</style>