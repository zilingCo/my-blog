---
import Layout from '../layouts/Layout.astro';

const posts = [
  { title: '我的第一篇文章', date: '2026-09-29', slug: 'hello' ,href:"http://www.baidu.com"},
  { title: '开始学', date: '2026-09-28', slug: 'astro-start' },
];
---

<Layout title="zilingCo 的博客">
  <h1>Hello，我是 zilingCo</h1>
  <p>这里是我的个人博客，记录学习和输出的过程。</p>

  <h2>最新文章</h2>
  <ul>
    {posts.map(post => (
      <li>
        <a href={`/blog/${post.slug}`}>{post.title}</a>
        <time> · {post.date}</time>
      </li>
    ))}
  </ul>
</Layout>